<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CEO Dashboard Client Action -->
    <record id="action_ceo_dashboard" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">ceo_dashboard.dashboard</field>
    </record>

    <!-- Executive Dashboard Menu -->
    <menuitem id="menu_ceo_dashboard_root"
              name="Executive Dashboard"
              sequence="1"
              web_icon="ceo_dashboard,static/description/icon.png"
              groups="ceo_dashboard.group_ceo_dashboard_user"/>

    <menuitem id="menu_ceo_dashboard_main"
              name="Dashboard"
              parent="menu_ceo_dashboard_root"
              action="action_ceo_dashboard"
              sequence="1"/>

</odoo>